<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
	<Script file="CheckBuffs.lua" />
	<Frame name="check_buffs_counter_core" enableMouse="true" movable="true"
		frameStrata="MEDIUM"
		toplevel="true" hidden="false" parent="UIParent">
		<Size>
			<AbsDimension x="128" y="64" />
		</Size>
		<Anchors>
			<Anchor point="RIGHT" relativeTo="Minimap" relativePoint="LEFT">
				<Offset>
					<AbsDimension x="0" y="0" />
				</Offset>
			</Anchor>
		</Anchors>
		<Frames>
			<Frame name="check_buffs_rf">
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="0" y="0" />
						</Offset>
					</Anchor>
				</Anchors>
				<Size>
					<AbsDimension x="64" y="64" />
		        </Size>
		        <Layers>
			        <Layer level="BACKGOUND">
				        <Texture name="TEXTURE" file="Interface\Icons\Spell_Holy_SealOfFury">
					        <Size>
						        <AbsDimension x="64" y="64" />
					        </Size>
					        <Anchors>
						        <Anchor point="TOPLEFT">
							        <Offset>
								        <AbsDimension x="0" y="0" />
							        </Offset>
						        </Anchor>
					        </Anchors>
				        </Texture>
			        </Layer>
		        </Layers>
			</Frame>
			<Frame name="check_buffs_aura" inherits="check_buffs_CounterTemplate">
				<Anchors>
					<Anchor point="LEFT" relativeTo="check_buffs_rf" relativePoint="RIGHT">
						<Offset>
							<AbsDimension x="0" y="0" />
						</Offset>
					</Anchor>
				</Anchors>
				<Size>
					<AbsDimension x="64" y="64" />
		        </Size>
		        <Layers>
			        <Layer level="BACKGOUND">
				        <Texture name="TEXTURE" file="Interface\Icons\Spell_Holy_AuraOfLight">
					        <Size>
						        <AbsDimension x="64" y="64" />
					        </Size>
					        <Anchors>
						        <Anchor point="TOPLEFT">
							        <Offset>
								        <AbsDimension x="0" y="0" />
							        </Offset>
						        </Anchor>
					        </Anchors>
				        </Texture>
			        </Layer>
		        </Layers>
			</Frame>
		</Frames>
		<Layers>
			<Layer level="BACKGROUND">
				<FontString name="check_buffs_counter_display" hidden="false"
					inherits="GameFontNormal">
					<Anchors>
						<Anchor point="TOP">
							<Offset>
								<AbsDimension x="0" y="-10" />
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>
				Check_Buffs_OnLoad();
			</OnLoad>
			<OnEvent>
				Check_Buffs_OnEvent();
			</OnEvent>
			<OnDragStart>
				Check_Buffs_OnDragStart();
			</OnDragStart>
			<OnDragStop>
				Check_Buffs_OnDragStop();
			</OnDragStop>
		</Scripts>
	</Frame>
</Ui>