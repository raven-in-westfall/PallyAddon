<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
	<Script file="Redoubt.lua" />
	<Frame name="RedoubtCounterTemplate" virtual="true">
		<Size>
			<AbsDimension x="12" y="12" />
		</Size>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture file="Interface\ComboFrame\ComboPoint">
					<Size>
						<AbsDimension x="12" y="16" />
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT" />
					</Anchors>
					<TexCoords left="0" right="0.375" top="0" bottom="1" />
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture name="$parentHighlight" file="Interface\ComboFrame\ComboPoint">
					<Size>
						<AbsDimension x="8" y="16" />
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="2" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
					<TexCoords left="0.375" right="0.5625" top="0" bottom="1" />
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture name="$parentShine" file="Interface\ComboFrame\ComboPoint" alphaMode="ADD">
					<Size>
						<AbsDimension x="14" y="16" />
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="0" y="4" />
							</Offset>
						</Anchor>
					</Anchors>
					<TexCoords left="0.5625" right="1" top="0" bottom="1" />
				</Texture>
			</Layer>
		</Layers>
	</Frame>
	<Frame name="redoubtcounter_core" enableMouse="true" movable="true" frameStrata="MEDIUM"
		toplevel="true" hidden="false" parent="UIParent">
		<Size>
			<AbsDimension x="128" y="48" />
		</Size>
		<Anchors>
			<Anchor point="RIGHT" relativeTo="Minimap" relativePoint="LEFT">
				<Offset>
					<AbsDimension x="-12" y="-50" />
				</Offset>
			</Anchor>
		</Anchors>
		<Frames>
			<Frame name="RedoubtCounter1" inherits="RedoubtCounterTemplate">
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="12" y="-24" />
						</Offset>
					</Anchor>
				</Anchors>
			</Frame>
			<Frame name="RedoubtCounter2" inherits="RedoubtCounterTemplate">
				<Anchors>
					<Anchor point="TOP" relativeTo="RedoubtCounter1" relativePoint="RIGHT">
						<Offset>
							<AbsDimension x="24" y="6" />
						</Offset>
					</Anchor>
				</Anchors>
			</Frame>
			<Frame name="RedoubtCounter3" inherits="RedoubtCounterTemplate">
				<Anchors>
					<Anchor point="TOP" relativeTo="RedoubtCounter2" relativePoint="RIGHT">
						<Offset>
							<AbsDimension x="24" y="6" />
						</Offset>
					</Anchor>
				</Anchors>
			</Frame>
			<Frame name="RedoubtCounter4" inherits="RedoubtCounterTemplate">
				<Anchors>
					<Anchor point="TOP" relativeTo="RedoubtCounter3" relativePoint="RIGHT">
						<Offset>
							<AbsDimension x="24" y="6" />
						</Offset>
					</Anchor>
				</Anchors>
			</Frame>
			<Frame name="RedoubtCounter5" inherits="RedoubtCounterTemplate">
				<Anchors>
					<Anchor point="TOP" relativeTo="RedoubtCounter4" relativePoint="RIGHT">
						<Offset>
							<AbsDimension x="24" y="6" />
						</Offset>
					</Anchor>
				</Anchors>
			</Frame>
		</Frames>
		<Layers>
			<Layer level="BACKGROUND">
				<FontString name="redoubtcounter_display" hidden="false" inherits="GameFontNormal">
					<Anchors>
						<Anchor point="TOP">
							<Offset>
								<AbsDimension x="0" y="-10" />
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnEvent>
				redoubtcounter_OnEvent();
			</OnEvent>
			<OnDragStart>
				PallyAddonOnDragStart(redoubtcounter_core);
			</OnDragStart>
			<OnDragStop>
				PallyAddonOnDragStop(redoubtcounter_core);
			</OnDragStop>
		</Scripts>
	</Frame>
</Ui>